# Optional. Without it the app falls back to Yahoo Finance, which needs no key
# but throttles shared IP addresses — metals in particular can drop to modelled
# data during a throttle. A free Twelve Data key (800 requests/day, 8/minute)
# removes that dependency and covers XAU/USD and XAG/USD natively.
#
# Get one at https://twelvedata.com/pricing (free tier), then add it in
# Vercel → Settings → Environment Variables as TWELVE_DATA_API_KEY.
TWELVE_DATA_API_KEY=

# Optional. Enables GPT-4o-mini narration in the AI Tools tab.
# Without it the assistant still answers, composed on-device by the deterministic
# command engine from the same real market data — nothing is faked either way.
#
# What is sent when this is set: aggregated journal statistics only (trade count,
# win rate, best/worst hour, pair and session, and a one-line summary of the last
# loss). The imported statement itself never leaves the browser.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Partner (IB) deposit gating -------------------------------------------

# Partner codes. These are public — they appear in the link the visitor clicks —
# so NEXT_PUBLIC_ is deliberate rather than a leak.
NEXT_PUBLIC_IB_VTMARKETS=
NEXT_PUBLIC_IB_PUPRIME=
NEXT_PUBLIC_IB_VANTAGE=

# Required for the verification queue at /dashboard?tab=admin. Without it the
# admin route returns 503 and the queue stays closed.
GFXA_ADMIN_TOKEN=

# Required for the queue to work at all. Provisioning Vercel KV on the project
# sets both automatically; without them requests are written to per-route memory
# and are not visible to the other routes, so nothing can be reviewed.
KV_REST_API_URL=
KV_REST_API_TOKEN=
